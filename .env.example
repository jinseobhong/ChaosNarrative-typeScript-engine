# ====================================================================
# ABYSS ENGINE LLM API CONFIGURATION
# ====================================================================

# [1] Google Gemini API Key
# Google AI Studio (https://aistudio.google.com/)에서 발급받은 API 키
GEMINI_API_KEY=

# [2] Anthropic Claude API Key
# Anthropic Console (https://console.anthropic.com/)에서 발급받은 API 키
ANTHROPIC_API_KEY=

# [3] Anthropic Workspace ID (Identity-linked API 키를 사용할 경우 필수)
# Anthropic Console의 Settings -> Workspaces에서 확인 가능 (예: wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

# [4] 서버 포트 설정
SERVER_PORT=3001
